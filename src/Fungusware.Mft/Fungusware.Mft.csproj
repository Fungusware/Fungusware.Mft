<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Fungusware.Mft</RootNamespace>
    <PackageId>Fungusware.Mft</PackageId>
    <Description>Reads an NTFS volume's Master File Table directly: every file name and size on a drive in seconds, for "where did the space go" tools. Read only, no native code.</Description>
    <Authors>Fungusware</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ntfs;mft;disk;filesystem</PackageTags>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/Fungusware/Fungusware.Mft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Fungusware/Fungusware.Mft</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
